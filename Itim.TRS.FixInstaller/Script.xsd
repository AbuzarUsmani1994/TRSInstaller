<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="ScriptGroup">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" name="Script">
          <xs:complexType mixed="true">
            <xs:sequence minOccurs="0">
              <xs:element name="ParallelGroup">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element maxOccurs="unbounded" name="Parallel">
                      <xs:complexType>
                        <xs:attribute name="name" type="xs:string" use="required" />
                        <xs:attribute name="scriptName" type="xs:string" use="optional" />
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required" />
            <xs:attribute name="seq" type="xs:int" use="required" />
            <xs:attribute name="scriptName" type="xs:string" use="optional" />
            <xs:attribute name="Mandatory" type="xs:boolean" use="optional" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="scriptBaseDir" type="xs:string" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>