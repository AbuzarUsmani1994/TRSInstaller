<Window x:Class="FixInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRS Fix Installer"
        Height="586" 
        Width="406" 
        ResizeMode="NoResize"
        UseLayoutRounding="False"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" >
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Skin\Skin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid 
        Background="#FF272727" 
        AllowDrop="True" 
        Height="586" 
        Width="406" 
        MouseDown="Grid_MouseDown">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="466*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Button 
            Content="x" 
            Height="29" 
            HorizontalAlignment="Left" 
            Margin="374,0,0,0"  
            Name="btnClose" 
            VerticalAlignment="Top" 
            Width="25" 
            Click="btnClose_Click" 
            FontStyle="Normal" 
            FontWeight="Bold" 
            MinHeight="30" 
            OverridesDefaultStyle="False" 
            Padding="0" 
            Style="{StaticResource ControlBoxButtonBase}">            
        </Button>
        

        <Button 
            Content="_" 
            Height="29" 
            Margin="346,0,0,0" 
            Name="btnMinimize" 
            VerticalAlignment="Top"
            FontStyle="Normal"    
            FontWeight="Bold" 
            MinHeight="30"
            OverridesDefaultStyle="False"
            Padding="0" 
            Click="btnMinimize_Click"
            HorizontalAlignment="Left"
            Width="25"  
            Style="{StaticResource ControlBoxButtonBase}">
        </Button>
        
        <TextBlock 
            TextWrapping="Wrap"
            Name="txtHeading"
            Text="TRS Fix Installer"
            Width="300"
            Margin="17,49,88.131,486" 
            Foreground="White" 
            FontSize="28" 
            FontStyle="Normal" 
            FontStretch="Normal"
            FontWeight="Light">
        </TextBlock>

        <Label 
            Height="28" 
            HorizontalAlignment="Center" 
            Margin="8,90,15.131,0"
            Name="lblFilePath"
            VerticalAlignment="Top"
            Width="382" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Bottom"
            Foreground="#FFB3B3B3" FontSize="13">
                <TextBlock TextWrapping="Wrap" Name="txtBlock" Width="375">
                    Installs TRS Hotfix(es)/Patch(es) on all machines (App, Web, DB).
                </TextBlock>
        </Label>
        
        <Label 
            Content="Script Log" 
            Height="28"
            HorizontalAlignment="Left"
            Margin="12,124,0,0"
            Name="label1"
            VerticalAlignment="Top" 
            Foreground="#FFB3B3B3"
            FontSize="13" />

        <RichTextBox 
            Height="360"
            HorizontalAlignment="Left" 
            Margin="13,152,0,0" 
            Name="txtLog" 
            VerticalAlignment="Top"
            Width="382"  
            Background="#FF272727"
            BorderBrush="#FF0097FB" 
            BorderThickness="2" IsReadOnly="True" 
            FontSize="13" Foreground="White" 
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto" 
            ScrollViewer.CanContentScroll="True" 
            ScrollViewer.IsDeferredScrollingEnabled="True" TextChanged="txtLog_TextChanged">
        </RichTextBox>
        <Button
            Content="Install"
            Height="32"
            HorizontalAlignment="Left" 
            Margin="174.565,534,0,0" 
            Name="btnInstall"
            VerticalAlignment="Top" 
            Width="107" 
            BorderThickness="1" 
            TabIndex="1"
            MinHeight="0" Click="btnInstall_Click" />
        <Button
            Content="Cancel"
            Height="32"
            HorizontalAlignment="Left" 
            Margin="288.565,534,0,0" 
            Name="btnCancel"
            VerticalAlignment="Top" 
            Width="107" 
            BorderThickness="1" 
            TabIndex="1"
            MinHeight="0" Click="btnCancel_Click" />
        <ProgressBar 
            Height="12" 
            Foreground="Blue" 
            HorizontalAlignment="Left"
            Margin="13,515.541,0,0"
            Name="progBar"
            VerticalAlignment="Top"
            Width="382" />
    </Grid>
</Window>
