<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <system.serviceModel>
    <services>
      <service name="Itim.TRS.FixInstaller.Service.TRSFixService" behaviorConfiguration="TRSFixServiceBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:13749/TRSFixInstaller/service"/>
          </baseAddresses>
        </host>

        <endpoint address="" binding="wsHttpBinding" contract="Itim.TRS.FixInstaller.Service.ITRSFixService"/>

        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="TRSFixServiceBehavior">
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="false"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <log4net debug="false">
    <!-- Appender for logging normal messages to a day rolling file -->
    <appender name="FileAppender" type="log4net.Appender.RollingFileAppender,log4net">
      <param name="file" value="Logs\Install.Current.log"/>
      <param name="AppendToFile" value="false"/>
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="1GB" />
      <layout type="log4net.Layout.PatternLayout,log4net">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n"/>
      </layout>
    </appender>
    <!-- Configuration for the root logger. Unless overriden all loggers will inherit this configuration -->
    <root>
      <priority value="DEBUG"/>
      <level value="ALL" />
      <appender-ref ref="FileAppender"/>
    </root>
  </log4net>
	<appSettings>
		<add key="WebConfigPath" value="C:\Program Files (x86)\Itim\The Retail Suite\Web\IR\web.config" />
	</appSettings>
</configuration>

